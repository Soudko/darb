# Setting NAMES only. Never put a value here. Real values go in .env (this Mac) or Replit Secrets.
HOST=
PORT=
# The simplest setup: only OPENAI_API_KEY (OpenAI, model gpt-6-luna unless AI_MODEL says otherwise).
OPENAI_API_KEY=
AI_MODEL=
# For another OpenAI-compatible server (for example LM Studio on this Mac):
AI_BASE_URL=
AI_API_KEY=
# Replit AI Integrations, used only when none of the above is set:
# AI_INTEGRATIONS_OPENAI_BASE_URL
# AI_INTEGRATIONS_OPENAI_API_KEY
